    {
      "parameters": {
        "jsCode": "// Ambil item pertama dari input\nconst input = $input.first().json;\n\n// Path ke teks JSON dari Gemini\nconst rawJson = input.content?.parts?.[0]?.text;\n\nif (typeof rawJson !== 'string') {\n  throw new Error('Tidak menemukan field content.parts[0].text');\n}\n\n// Bersihkan pembungkus code block kalau ada\nconst cleanedJson = rawJson.replace(/```json\\n?|```/g, '');\n\n// Parse menjadi array\nconst parsedData = JSON.parse(cleanedJson);\n\n// Pastikan array\nif (!Array.isArray(parsedData)) {\n  throw new Error('Data yang di-parse bukan array.');\n}\n\n// Format output agar sesuai dengan Google Sheets node\nreturn parsedData.map(item => ({\n  json: {\n    Title: item.Title || '',\n    Description: item.Description || '',\n    Keywords: Array.isArray(item.Keywords)\n      ? item.Keywords.join(',')\n      : (item.Keywords || '')\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        0
      ],
